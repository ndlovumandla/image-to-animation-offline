# =============================================================================
# Sketch Video Studio — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.
# =============================================================================

# Application release tag (pinned version or git SHA for production deployments)
APP_VERSION=0.1.0

# Public domain routed via Cloudflare Tunnel & Caddy (use localhost for local testing)
APP_DOMAIN=localhost
PORTAINER_DOMAIN=portainer.localhost

# Frontend build-time API base URL (empty string routes via same-origin /api/* in Caddy)
VITE_BG_API_BASE=

# Backend AI Service settings
HOST=0.0.0.0
PORT=7000
MAX_UPLOAD_BYTES=20971520
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8880

# Local host port binding for Caddy HTTP testing ( avoids conflict with Moodle on 8080 )
CADDY_HTTP_PORT=8880

# Cloudflare Tunnel Token (Required only in production compose.infra.yaml; store in /etc/sketch-studio/infra.env)
TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token
